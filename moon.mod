// moonkube — a Kubernetes API client and controller framework for MoonBit,
// written from scratch with zero runtime dependencies.

name = "Rz-coder8848/moonkube"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/Rz-coder8848/moonkube"

license = "Apache-2.0"

keywords = [
  "kubernetes",
  "k8s",
  "client",
  "controller",
  "informer",
  "watch",
  "patch",
  "quantity",
  "selector",
]

preferred_target = "wasm"

description = "A pure-MoonBit Kubernetes client: kubeconfig, typed resources, quantities, label selectors, JSON/Merge/Strategic patches, list-watch informers and a controller framework. Zero runtime dependencies."
